    },
    "hospital_course": {
      "title": "Hospital Course",
      "code": {
        "code": "8648-8",
        "display_name": "Hospital Course Narrative",
        "code_system": "2.16.840.1.113883.6.1",
        "code_system_name": "LOINC"
      },
      "template_ids": [
        "2.16.840.1.113883.10.20.22.2.44"
      ],
      "narrative": "Patient is a 34-year-old male who presented to the Emergency Department with a 1-day history of periumbilical pain migrating to the right lower quadrant with rebound tenderness. Abdominal CT demonstrated acute suppurative appendicitis with appendicolith without signs of perforation or abscess. Patient was admitted to General Surgery service, started on IV fluids and IV cefoxitin, and taken to the operating room on 2023-09-10 for an uneventful laparoscopic appendectomy.\nPostoperative course was smooth. Bowel sounds returned on post-op day 1, and the patient tolerated progression from clear liquids to a regular diet. Incisions are clean, intact, without erythema or drainage. Pain was well-managed with oral acetaminophen and ibuprofen. Patient is discharged home on post-op day 2 in stable condition.",
      "tables": [],
      "entries": [],
      "section_type": "hospital_course"
    },
