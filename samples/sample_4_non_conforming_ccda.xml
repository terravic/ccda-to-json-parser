<?xml version="1.0" encoding="UTF-8"?>
<!--
  SAMPLE 4: NON-CONFORMING / MALFORMED C-CDA CLINICAL DOCUMENT
  =============================================================
  Purpose: Designed specifically to test C-CDA validation error detection,
  schema violation catching, graceful parsing degradation, and error recovery.

  Demonstrated Conformance Violations & Schema Defects:
  1. Missing standard US Realm Header templateId (2.16.840.1.113883.10.20.22.1.1)
  2. Missing document type codeSystem and displayName in <code/>
  3. Malformed document effectiveTime ("INVALID_TS_20239999")
  4. Incomplete patient demographics: unstructured <name>, missing <administrativeGenderCode>, malformed birthTime ("NOT_A_VALID_DATE")
  5. Medications section missing standard C-CDA templateId
  6. Broken narrative references (<reference value="#missing_med_item_999"/>)
  7. Non-numeric dosage value in <doseQuantity value="TWICE_DAILY" unit="mg"/>
  8. Missing <consumable> in substanceAdministration entry
  9. Malformed numeric values (<value xsi:type="PQ" value="NaN" unit="mg/dL"/>)
  10. Missing LOINC code in vital signs observation
  11. Unrecognized custom section with missing LOINC section heading code
-->
<ClinicalDocument xmlns="urn:hl7-org:v3" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sdtc="urn:hl7-org:sdtc">
  <!-- DEFECT 1: Missing standard US Realm Header templateId -->
  <templateId root="1.3.6.1.4.1.99999.custom.vendor.template" extension="draft-0.1"/>
  
  <id root="2.16.840.1.113883.19.5" extension="MALFORMED-DOC-2023-004"/>
  
  <!-- DEFECT 2: Incomplete document type code without codeSystemName or displayName -->
  <code code="00000-0"/>
  
  <title>Non-Conforming Synthetic Medical Summary (Test Case)</title>
  
  <!-- DEFECT 3: Corrupted HL7 Timestamp format -->
  <effectiveTime value="INVALID_TS_20239999"/>
  
  <!-- DEFECT 4: Unknown / invalid confidentiality code -->
  <confidentialityCode code="UNKNOWN_CONF" nullFlavor="OTH"/>

  <recordTarget>
    <patientRole>
      <!-- Incomplete ID without assigningAuthority -->
      <id root="2.16.840.1.113883.19.5" extension="UNKNOWN-PATIENT-001"/>
      <addr>
        <streetAddressLine>100 Unverified Street</streetAddressLine>
        <city>Unknown City</city>
        <state>XX</state>
      </addr>
      <patient>
        <!-- DEFECT 5: Free-text unstructured name without <given> or <family> tags -->
        <name>Jane "Anonymous" Doe (Unverified Identity)</name>
        <!-- DEFECT 6: Missing administrativeGenderCode -->
        <!-- DEFECT 7: Malformed non-numeric birthTime -->
        <birthTime value="NOT_A_VALID_DATE"/>
      </patient>
    </patientRole>
  </recordTarget>

  <author>
    <time value="20230514143000"/>
    <assignedAuthor>
      <id root="2.16.840.1.113883.4.6" extension="9999999999"/>
      <assignedPerson>
        <name>Dr. Unregistered Clinician, MD</name>
      </assignedPerson>
    </assignedAuthor>
  </author>

  <custodian>
    <assignedCustodian>
      <representedCustodianOrganization>
        <name>Community Emergency Triage Clinic</name>
      </representedCustodianOrganization>
    </assignedCustodian>
  </custodian>

  <!-- Structured Body with non-conforming sections and entries -->
  <component>
    <structuredBody>

      <!-- ============================================================= -->
      <!-- SECTION 1: MEDICATIONS WITH MISSING TEMPLATE & BROKEN REFS    -->
      <!-- ============================================================= -->
      <component>
        <!-- DEFECT 8: Missing standard Medication section templateId (2.16.840.1.113883.10.20.22.2.1.1) -->
        <section>
          <code code="10160-0" codeSystem="2.16.840.1.113883.6.1" displayName="History of Medication use"/>
          <title>Medications &amp; Prescriptions (Malformed Test Entries)</title>
          <text>
            <paragraph id="med_desc_1">Patient reports taking unknown antibiotic daily.</paragraph>
          </text>
          
          <!-- Entry 1: Broken Reference and Non-Numeric Dose -->
          <entry typeCode="DRIV">
            <substanceAdministration classCode="SBADM" moodCode="EVN">
              <templateId root="2.16.840.1.113883.10.20.22.4.16"/>
              <statusCode code="active"/>
              <effectiveTime xsi:type="IVL_TS">
                <low value="20230101"/>
              </effectiveTime>
              <!-- DEFECT 9: Non-numeric dosage value string -->
              <doseQuantity value="TWO_TABLETS" unit="tablets"/>
              <consumable>
                <manufacturedProduct classCode="MANU">
                  <manufacturedMaterial>
                    <!-- DEFECT 10: Broken narrative reference pointing to non-existent ID -->
                    <code nullFlavor="OTH">
                      <originalText><reference value="#missing_med_item_999"/></originalText>
                    </code>
                  </manufacturedMaterial>
                </manufacturedProduct>
              </consumable>
            </substanceAdministration>
          </entry>

          <!-- Entry 2: DEFECT 11: substanceAdministration completely missing <consumable> element -->
          <entry typeCode="DRIV">
            <substanceAdministration classCode="SBADM" moodCode="EVN">
              <templateId root="2.16.840.1.113883.10.20.22.4.16"/>
              <statusCode code="completed"/>
              <effectiveTime xsi:type="IVL_TS">
                <low value="20220501"/>
                <high value="20220510"/>
              </effectiveTime>
              <!-- Missing consumable element entirely -->
            </substanceAdministration>
          </entry>
        </section>
      </component>

      <!-- ============================================================= -->
      <!-- SECTION 2: ALLERGIES WITH INVALID NULL FLAVORS & UNKNOWN CODE  -->
      <!-- ============================================================= -->
      <component>
        <section>
          <templateId root="2.16.840.1.113883.10.20.22.2.6.1" extension="2015-08-01"/>
          <code code="48765-2" codeSystem="2.16.840.1.113883.6.1" displayName="Allergies, adverse reactions, alerts"/>
          <title>Allergies and Adverse Reactions</title>
          <text>
            <paragraph>Unspecified adverse reaction to generic household cleaner.</paragraph>
          </text>
          <entry typeCode="DRIV">
            <act classCode="ACT" moodCode="EVN">
              <templateId root="2.16.840.1.113883.10.20.22.4.30"/>
              <statusCode code="active"/>
              <entryRelationship typeCode="SUBJ">
                <observation classCode="OBS" moodCode="EVN">
                  <templateId root="2.16.840.1.113883.10.20.22.4.7"/>
                  <statusCode code="completed"/>
                  <!-- DEFECT 12: Participant with unrecognized null flavor and missing codeSystem -->
                  <participant typeCode="CSM">
                    <participantRole classCode="MANU">
                      <playingEntity classCode="MMAT">
                        <code nullFlavor="INVALID_FLAVOR_XYZ"/>
                      </playingEntity>
                    </participantRole>
                  </participant>
                  <!-- Missing severity observation -->
                </observation>
              </entryRelationship>
            </act>
          </entry>
        </section>
      </component>

      <!-- ============================================================= -->
      <!-- SECTION 3: VITAL SIGNS WITH MISSING CODES & CORRUPT VALUES     -->
      <!-- ============================================================= -->
      <component>
        <section>
          <templateId root="2.16.840.1.113883.10.20.22.2.4.1"/>
          <code code="8716-3" codeSystem="2.16.840.1.113883.6.1" displayName="Vital Signs"/>
          <title>Vital Signs (Corrupted Observation Entries)</title>
          <text>
            <paragraph>Corrupted vitals telemetry data feed.</paragraph>
          </text>
          <entry typeCode="DRIV">
            <organizer classCode="CLUSTER" moodCode="EVN">
              <templateId root="2.16.840.1.113883.10.20.22.4.26"/>
              <statusCode code="completed"/>
              <effectiveTime value="20230514140000"/>
              <component>
                <!-- Observation 1: DEFECT 13: Missing observation <code> element -->
                <observation classCode="OBS" moodCode="EVN">
                  <templateId root="2.16.840.1.113883.10.20.22.4.27"/>
                  <statusCode code="completed"/>
                  <!-- Missing <code/> -->
                  <value xsi:type="PQ" value="120" unit="mm[Hg]"/>
                </observation>
              </component>
              <component>
                <!-- Observation 2: DEFECT 14: Non-numeric NaN value and missing unit -->
                <observation classCode="OBS" moodCode="EVN">
                  <templateId root="2.16.840.1.113883.10.20.22.4.27"/>
                  <code code="8867-4" codeSystem="2.16.840.1.113883.6.1" displayName="Heart Rate"/>
                  <statusCode code="completed"/>
                  <value xsi:type="PQ" value="NaN"/>
                </observation>
              </component>
            </organizer>
          </entry>
        </section>
      </component>

      <!-- ============================================================= -->
      <!-- SECTION 4: DIAGNOSTIC RESULTS WITH MISSING VALUES              -->
      <!-- ============================================================= -->
      <component>
        <section>
          <templateId root="2.16.840.1.113883.10.20.22.2.3.1"/>
          <code code="30954-2" codeSystem="2.16.840.1.113883.6.1" displayName="Relevant diagnostic tests/laboratory data"/>
          <title>Laboratory Results (Incomplete Test Results)</title>
          <text>
            <paragraph>Incomplete rapid point-of-care test panel.</paragraph>
          </text>
          <entry typeCode="DRIV">
            <organizer classCode="BATTERY" moodCode="EVN">
              <templateId root="2.16.840.1.113883.10.20.22.4.1"/>
              <statusCode code="completed"/>
              <component>
                <!-- Observation: DEFECT 15: Observation completely missing <value> element -->
                <observation classCode="OBS" moodCode="EVN">
                  <templateId root="2.16.840.1.113883.10.20.22.4.2"/>
                  <code code="2339-0" codeSystem="2.16.840.1.113883.6.1" displayName="Glucose [Mass/volume] in Blood"/>
                  <statusCode code="completed"/>
                  <!-- Missing <value/> -->
                </observation>
              </component>
            </organizer>
          </entry>
        </section>
      </component>

      <!-- ============================================================= -->
      <!-- SECTION 5: UNRECOGNIZED VENDOR SECTION WITHOUT LOINC CODE      -->
      <!-- ============================================================= -->
      <component>
        <!-- DEFECT 16: Custom section with no standard LOINC code or templateId -->
        <section>
          <title>Custom Unregistered Telehealth Notes</title>
          <text>
            <paragraph>Patient was contacted via preliminary video triage call. Audio quality was degraded.</paragraph>
          </text>
        </section>
      </component>

    </structuredBody>
  </component>
</ClinicalDocument>
